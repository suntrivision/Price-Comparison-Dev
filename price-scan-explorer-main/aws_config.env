# AWS Configuration for Ollama Product Matching
# Edit these values before running aws_ec2_launch.sh

# AWS Region (recommended: ap-southeast-1 for Singapore)
AWS_REGION=ap-southeast-1

# EC2 Instance Configuration
INSTANCE_TYPE=r6i.xlarge
AMI_ID=ami-0c02fb55956c7d316  # Ubuntu 22.04 LTS

# Your AWS Key Pair Name (REQUIRED - create one in AWS Console)
KEY_NAME=ollama-product-matcher

# Security Group Name
SECURITY_GROUP_NAME=ollama-product-matcher-sg

# IAM Role Name
IAM_ROLE_NAME=ollama-product-matcher-role

# S3 Bucket Configuration
S3_BUCKET_NAME=prodpromo
S3_BUCKET_REGION=ap-southeast-1

# Storage Configuration
EBS_VOLUME_SIZE=100  # GB
EBS_VOLUME_TYPE=gp3

# Network Configuration (leave empty for auto-detection)
VPC_ID=
SUBNET_ID=

# Application Configuration
GIT_REPO_URL=https://github.com/your-repo/price-scan-explorer-main.git
BRANCH_NAME=main

# Ollama Models to Install
OLLAMA_MODELS="nomic-embed-text llama3.1:8b"

# Python Dependencies
PYTHON_PACKAGES="pandas boto3 chromadb requests numpy sentence-transformers"

# Monitoring Configuration
ENABLE_CLOUDWATCH=true
LOG_RETENTION_DAYS=7

# Cost Optimization
ENABLE_AUTO_SHUTDOWN=false  # Set to true to auto-shutdown when idle
IDLE_TIMEOUT_HOURS=2

# Security Configuration
ALLOW_SSH_FROM=0.0.0.0/0  # Restrict to your IP for production
ALLOW_OLLAMA_API_FROM=0.0.0.0/0

# Backup Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Performance Configuration
OLLAMA_THREADS=4
CHROMA_DB_PERSISTENCE=true 